{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": ".test-build",
    "rootDir": ".",
    "noEmit": false,
    "incremental": false
  },
  "include": ["tests/**/*.ts"]
}
